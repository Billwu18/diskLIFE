# ---- generated by the tools, never commit ----
build/
dist/
*.iso
examples/sample-disc/

# personas created by Studio (they may contain personal content)
persona/
!persona/.gitkeep

# ---- secrets and local state: never commit ----
.credentials.yaml
*.credentials.yaml
.env
.env.*
state.json
logs/
sessions/
storages/

# ---- editors / OS ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ---- node ----
# payload/ is intentionally committed (offline profile snapshot);
# everything else node-ish is not.
node_modules/
!payload/profile-web/node_modules/
!payload/profile-web/node_modules/**

# ---- misc ----
*.log
*.tmp
*.bak
~$*
