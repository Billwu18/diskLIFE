# Normalize line endings: PowerShell and cmd need CRLF, everything else LF.
* text=auto eol=lf

*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.bat   text eol=crlf
*.inf   text eol=crlf

*.png   binary
*.ico   binary
*.iso   binary

# The payload snapshot is generated by npm/pnpm: don't let git rewrite it.
payload/profile-web/** -text
